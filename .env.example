ANTHROPIC_API_KEY=your_anthropic_api_key_here
JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=3000
BASE_URL=https://neuradesk.online

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Optional: discounted price for referred users (-15%)
STRIPE_PRICE_ID_DISCOUNTED=price_...

# Platby klientov (rezervácie, digitálne produkty, Funnely) – 0 % provízia
# Stripe Connect: kľúč platformy (ak funnel bežal na inom Stripe účte ako predplatné Neoworkly, jeho kľúč;
# inak sa použije STRIPE_SECRET_KEY) a verejný kľúč pre Stripe.js v snippetoch funnela
STRIPE_CONNECT_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Connect webhook (udalosti pripojených účtov) na https://neoworkly.com/api/webhook/connect
# udalosti: account.updated, account.application.deauthorized, checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired, charge.refunded
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Testovací režim funnelov (testovacie kľúče platformy, nepovinné)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
# Šifrovanie 2FA tajomstiev a Stripe kľúčov klientov: "nový,starší" (pri prechode z funnela PREVZIAŤ
# jeho hodnotu); bez neho sa šifruje odvodením z COOKIE_SECRET (predvolene JWT_SECRET)
TOTP_ENCRYPTION_KEYS=
COOKIE_SECRET=
# Staré predplatné Neoworkly Funnel (4 €) – iba pre klientov, ktorí ho ešte majú
FUNNEL_SUBSCRIPTION_PRICE_ID=price_...
# webhook https://neoworkly.com/api/webhook (customer.subscription.created/updated/deleted)
FUNNEL_STRIPE_WEBHOOK_SECRET=whsec_...
# Adresa API vo funnel snippetoch (predvolene APP_URL); stará doména funnela musí ostať nasmerovaná sem
PUBLIC_URL=
# Verejná adresa aplikácie (odkazy v e-mailoch, Stripe návraty)
APP_URL=https://neoworkly.com

# E-mail marketing (Resend, účet Neoworkly): kampane, automatické série, overenie domén klientov
RESEND_API_KEY=re_...
# Webhook v Resend → https://neoworkly.com/api/marketing/webhook (email.delivered, email.opened,
# email.clicked, email.bounced, email.complained, email.failed, email.suppressed) → jeho "Signing secret"
RESEND_WEBHOOK_SECRET=whsec_...
# Doména platformy overená v Resend – odtiaľ idú e-maily klientov, kým si neoveria vlastnú (napr. mail.neoworkly.com)
MARKETING_FROM_DOMAIN=
# Región nových domén klientov (eu-west-1, us-east-1, sa-east-1, ap-northeast-1)
RESEND_REGION=eu-west-1
# Limit marketingových e-mailov na účet za mesiac
MARKETING_MONTHLY_LIMIT=10000

# Disk: miesto na účet v MB (súbory sú na disku servera v data/drive)
DRIVE_QUOTA_MB=5120

# Videohovory (Jitsi Meet) – chat, úlohy, kalendár. Bez nastavenia sa použije meet.jit.si (otvorí sa v novom okne).
# Vlastný server: hovor sa vloží priamo do Neoworkly; s APP_ID/SECRET (token auth) vstúpia iba členovia tímu.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=

# Instagram / Meta (keyword DM bot)
# 1. Vytvorte app na developers.facebook.com
# 2. Pridajte produkt: Instagram → Messenger
# 3. Nastavte Webhook URL: https://neuradesk.online/api/instagram/webhook
# 4. Webhook Verify Token: akýkoľvek náhodný reťazec (rovnaký ako nižšie)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# SMTP (email notifikácie pri novom leade)
# Funguje s Gmail, Mailgun, SendGrid, Mailtrap, vlastný SMTP...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vas@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=NeuraDeskApp <vas@gmail.com>
